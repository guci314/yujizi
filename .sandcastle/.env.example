# Sandcastle 流水线凭据（复制为 .env 并填值；.env 已 gitignore）
#
# ⚠️ 只留这个流水线真正用到的变量。混进旧平台的 `OPENCODE_API_KEY=` 会压过
# opencode.json 里的 {env:OPENCODE_GO_API_KEY}，表现为容器内报
# 「This API key has expired」——而宿主 curl 同一个 key 打 /models 却是 200
# （该端点不校验鉴权，200 是假绿）。一击定性：
#   docker run --rm --entrypoint sh --env-file .sandcastle/.env sandcastle:yujizi-web \
#     -c 'opencode run -m opencode-go/glm-5.3-flash "回复一个字"'

# OpenCode Go（Zen 网关）API key。取当前 key：
#   python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.local/share/opencode/auth.json')))['opencode-go']['key'])"
OPENCODE_GO_API_KEY=

# GitHub token：agent 用它读 issue、评论、关闭 issue。
# 取法：gh auth token
GH_TOKEN=

# 容器内出网走宿主代理。大小写两份都要 —— 容器里不同工具读不同的写法。
HTTPS_PROXY=http://host.docker.internal:7890
HTTP_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1
https_proxy=http://host.docker.internal:7890
http_proxy=http://host.docker.internal:7890
no_proxy=localhost,127.0.0.1
